{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cruisemesh-web",
  "compatibility_date": "2026-07-12",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    {
      "pattern": "cruisemesh.app",
      "custom_domain": true
    }
  ]
}

