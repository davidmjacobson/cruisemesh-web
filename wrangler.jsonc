{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cruisemesh-web",
  "main": "src/index.js",
  "compatibility_date": "2026-07-12",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // Without this, `not_found_handling` answers HTML *navigation* requests
    // itself and never invokes the Worker — so a buyer returning from Stripe
    // got dist/404.html instead of their pass. It was invisible to curl-style
    // checks, which lack Sec-Fetch-Mode: navigate and so fall through to the
    // Worker, and to the webhook, which is a POST. The Worker falls through
    // to env.ASSETS.fetch() for everything it does not handle, so running it
    // first is safe and static pages still get `not_found_handling`.
    //
    // The mp4 is the one exception. A response the Worker proxies out of
    // env.ASSETS.fetch() loses byte-range support: no Accept-Ranges, and a
    // `Range:` request comes back 200 with the whole 7.6 MB. That breaks
    // seeking everywhere, and iOS Safari refuses to play media at all unless
    // the server answers 206 — which would have taken the explainer video
    // dark on a large share of the phones this site is aimed at. Listing it
    // as a negative rule hands that one path to the Asset Worker, which
    // serves ranges natively. Everything else still runs Worker-first, so
    // the http->https upgrade and the /relay/success fix are unaffected.
    "run_worker_first": ["/*", "!/cruisemesh-explainer.mp4"]
  },
  "observability": {
    "enabled": true
  },
  // Ops crons (src/ops.js, dispatched by the `scheduled` handler): every 15
  // minutes probes relay /healthz and emails on outage/recovery; the weekly
  // one reconciles D1 purchases against the relay's families table. Times
  // are UTC. These strings must byte-match UPTIME_CRON / RECONCILE_CRON in
  // src/ops.js (check.mjs enforces it), and trigger changes only take
  // effect on the next `npx wrangler deploy`.
  "triggers": {
    "crons": ["*/15 * * * *", "23 14 * * 1"]
  },
  "vars": {
    // Stripe Price id for the Cruise Pass one-time payment (LIVE mode, on
    // acct_1TvRdV0JgNc7Eg1G "CruiseMesh"). Must be swapped in the same breath
    // as STRIPE_SECRET_KEY — a live key with a test price id, or the reverse,
    // fails checkout with "no such price". Test price: price_1TvS7y0JgNc7Eg1GDzG9KiDc
    "STRIPE_PRICE_ID": "price_1TxPJx0JgNc7Eg1GJHqWyn0D",
    // Public base URL of the hosted relay that new passes are provisioned on.
    "RELAY_URL": "https://relay.cruisemesh.app",
    // Where the relayd admin API is reachable (usually the same host).
    "RELAY_ADMIN_ORIGIN": "https://relay.cruisemesh.app",
    // From-address for credential emails. The domain must be verified in
    // Resend first (see README) or every send is rejected.
    "EMAIL_FROM": "pass@cruisemesh.app"
  },
  // Secrets (set with `npx wrangler secret put <NAME>`):
  //   STRIPE_SECRET_KEY     - Stripe API secret key
  //   STRIPE_WEBHOOK_SECRET - signing secret of the Stripe webhook endpoint
  //   RELAY_ADMIN_TOKEN     - bearer token for the relayd admin API
  //   RESEND_API_KEY        - Resend API key; credential emails are skipped
  //                           entirely while it is unset
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cruisemesh-web",
      "database_id": "a480903a-2d92-4486-bc0e-11f8f689eb9c"
    }
  ],
  "routes": [
    {
      "pattern": "cruisemesh.app",
      "custom_domain": true
    }
  ]
}
